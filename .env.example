# Public origin used for canonical URLs, Open Graph, robots.txt and the
# sitemap. No trailing slash. On Vercel this falls back to the project's
# production URL; locally it falls back to http://localhost:3000.
SITE_URL=https://www.example.com

# Search engines are blocked (noindex + robots.txt disallow) unless this is
# exactly "true". Turn it on only after the owner approves the launch and
# SITE_URL points at the real domain; the build fails otherwise.
SITE_INDEXABLE=false
